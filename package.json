{
  "name": "shadowly-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:gateway": "npm run dev -w apps/gateway",
    "build": "npm run build -w apps/frontend && npm run build -w apps/gateway",
    "build:frontend": "npm run build -w apps/frontend",
    "build:gateway": "npm run build -w apps/gateway",
    "lint": "npm run lint -w apps/frontend && npm run lint -w apps/gateway",
    "lint:frontend": "npm run lint -w apps/frontend",
    "lint:gateway": "npm run lint -w apps/gateway",
    "typecheck": "npm run typecheck -w apps/frontend",
    "library:manifest": "npx tsx scripts/precompute-library.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
